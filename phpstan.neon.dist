parameters:
    level: 5
    paths:
        - src
    fileExtensions:
        - php
    ignoreErrors:
        - "#^Call to an undefined method Symfony\\\\Component\\\\Config\\\\Definition\\\\Builder\\\\NodeDefinition\\:\\:[a-zA-Z]+\\(\\)\\.$#"
        - "#^Call to an undefined method Symfony\\\\Component\\\\Config\\\\Definition\\\\Builder\\\\NodeParentInterface\\:\\:[a-zA-Z]+\\(\\)\\.$#"
